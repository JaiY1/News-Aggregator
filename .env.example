ANTHROPIC_API_KEY=your_key_here

# Comma-separated origins allowed to call the API cross-origin, e.g.
# https://yourwebsite.com,https://www.yourwebsite.com — defaults to "*"
ALLOWED_ORIGINS=*

# Where the SQLite DB lives. In production point this at a mounted persistent
# volume, e.g. /data
# DATA_DIR=/data

# Shared gate for signup + admin/cost endpoints. Unset locally = no gate.
ACCESS_CODE=
